table severity_transitions
	lineageTag: 3adc2150-1b33-4cd7-8118-5f3833792d36

	measure 'Severity changed (%)' = DIVIDE ( SUM ( severity_transitions[changed_severity] ), SUM ( severity_transitions[incidents] ) )
		formatString: 0.0%
		lineageTag: 9b881fab-79a6-4f39-8097-cd2724fcf661

	column incidents
		dataType: int64
		formatString: 0
		lineageTag: d2d46eaf-40d2-4430-9d89-ade50b9f4083
		summarizeBy: sum
		sourceColumn: incidents

		annotation SummarizationSetBy = Automatic

	column changed_severity
		dataType: int64
		formatString: 0
		lineageTag: e485d925-55f2-45a0-a876-6f59adb8b69c
		summarizeBy: sum
		sourceColumn: changed_severity

		annotation SummarizationSetBy = Automatic

	partition severity_transitions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\EDA Project\dashboards\severity_transitions.csv"),[Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"incidents", Int64.Type}, {"changed_severity", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table


table borough_performance
	lineageTag: bd1f4f10-de12-447e-b9ad-1ce15fec9b8c

	measure 'Total incidents' = SUM ( borough_performance[incidents] )
		formatString: #,0
		lineageTag: a202c102-5f31-4427-b593-9f60ac131491

	measure 'Average response (min)' = DIVIDE ( SUMX ( borough_performance, borough_performance[avg_incident_response_seconds] * borough_performance[valid_incident_response_count] ), 60 * SUM ( borough_performance[valid_incident_response_count] ) )
		formatString: 0.0
		lineageTag: 04f41c93-2baa-4e95-a418-69a1db1239b5

	measure 'Average dispatch (min)' = DIVIDE ( SUMX ( borough_performance, borough_performance[avg_dispatch_response_seconds] * borough_performance[valid_dispatch_response_count] ), 60 * SUM ( borough_performance[valid_dispatch_response_count] ) )
		formatString: 0.0
		lineageTag: df394ba4-dab3-471f-b925-495e644d5013

	measure 'Valid response records' = SUM ( borough_performance[valid_incident_response_count] )
		formatString: #,0
		lineageTag: 51cba999-8d96-4e57-a185-615789372cfc

